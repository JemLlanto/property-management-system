generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mysql"
}

model User {
  user_id       String   @id
  email         String   @unique
  password      String
  type          String   @default("Unit Owner") @map("type") @db.VarChar(20)
  name          String?  @map("name") @db.VarChar(100)
  unit_number   String?  @unique @map("unit_number") @db.VarChar(20)
  building      Int?     @map("building")
  refresh_tokens Json    @default("[]")
  created_at    DateTime? @default(now()) @map("created_at")
  updated_at    DateTime? @updatedAt @map("updated_at")

  payments_recorded Payment[] @relation("RecordedBy")

  @@index([building])
  @@map("users")
}

model Item {
  item_id    Int       @id @default(autoincrement()) @map("item_id")
  name       String
  user_id    String    @map("user_id")
  quantity   Int
  price      Decimal   @db.Decimal(10, 2)
  created_at DateTime? @default(now()) @map("created_at")
  updated_at DateTime? @default(now()) @updatedAt @map("updated_at")

  @@index([user_id])
  @@map("item")
}

model Building {
  building_id Int      @id @default(autoincrement()) @map("building_id")
  name        String   @db.VarChar(100)
  capacity    Int
  occupants   Int      @default(0)
  created_at  DateTime? @default(now()) @map("created_at")
  updated_at  DateTime? @default(now()) @updatedAt @map("updated_at")

  @@unique([name])
  @@map("building")
}

model Bill {
  bill_id    Int      @id @default(autoincrement()) @map("bill_id")
  name       String   @map("name") @db.VarChar(100)
  due_date   String   @map("due_date") @db.VarChar(20)
  amount     Decimal  @db.Decimal(10, 2)
  created_at DateTime? @default(now()) @map("created_at")
  updated_at DateTime? @default(now()) @updatedAt @map("updated_at")

  payments Payment[]

  @@map("bill")
}

model Payment {
  payment_id    Int       @id @default(autoincrement()) @map("payment_id")
  bill_id       Int       @map("bill_id")
  // Unit number of the payer at payment time — a plain value, not a FK, so
  // history survives the payer's account being edited or deleted.
  paid_by_id    String?   @map("paid_by_id") @db.VarChar(20)
  recorded_by_id String?  @map("recorded_by_id") @db.VarChar(12)
  amount        Decimal   @db.Decimal(10, 2)
  paid_at       DateTime  @default(now()) @map("paid_at")
  created_at    DateTime? @default(now()) @map("created_at")
  updated_at    DateTime? @default(now()) @updatedAt @map("updated_at")

  bill       Bill   @relation(fields: [bill_id], references: [bill_id])
  recordedBy User?  @relation("RecordedBy", fields: [recorded_by_id], references: [user_id], onDelete: SetNull)

  @@index([bill_id])
  @@index([paid_by_id])
  @@index([recorded_by_id])
  @@map("payment")
}

model Stock {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(100)
  specs String @db.VarChar(100)

  @@map("stocks")
}

model StockItem {
  id           Int       @id @default(autoincrement())
  stockId      Int       @map("stockId")
  serialNumber String?   @map("serialNumber") @db.VarChar(100)
  specs        String?   @db.Text
  PRDate       String?   @map("PRDate") @db.VarChar(100)
  receivedDate DateTime? @map("receivedDate") @db.Date
  deployedDate DateTime? @map("deployedDate") @db.Date
  station      String?   @db.VarChar(100)
  department   String?   @db.VarChar(100)
  remarks      String?   @db.VarChar(100)

  @@index([stockId])
  @@map("stock_items")
}

